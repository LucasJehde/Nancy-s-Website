:root {
  --color-primary: #002C77;
  --color-primary-dark: #001a47;
  --color-accent: #E61A29;
  --color-accent-light: #f5e6e8;
  --color-bg: #f8f9fa;
  --color-surface: #ffffff;
  --color-text: #1c2938;
  --color-text-light: #666666;
  --color-border: #e0e0e0;
  --color-gray-light: #f2f2f2;
  --color-green: #6f9e31;
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.1);
  --radius: 8px;
  --container-max: 1160px;
  --header-height: 80px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Open Sans", -apple-system, BlinkMacSystemFont, sans-serif;
  color: var(--color-text);
  background: var(--color-bg);
  line-height: 1.6;
}

h1, h2, h3, h4, h5, h6 {
  font-family: "Roboto", -apple-system, sans-serif;
  font-weight: 700;
  line-height: 1.2;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
  max-width: 100%;
}

.skip-link {
  position: absolute;
  left: 16px;
  top: -44px;
  z-index: 50;
  padding: 10px 14px;
  background: var(--color-text);
  color: #fff;
  border-radius: var(--radius);
  transition: top 0.2s ease;
}

.skip-link:focus {
  top: 14px;
}

.container {
  width: min(100% - 40px, var(--container-max));
  margin: 0 auto;
}

.section {
  padding: 80px 0;
}

/* ==================== HEADER ==================== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 40;
  min-height: var(--header-height);
  background: #fff;
  border-bottom: 1px solid var(--color-border);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
}

.nav {
  height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0;
  min-width: 200px;
}

.brand-mark {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #fff;
  font-weight: 900;
  font-size: 18px;
  border-radius: var(--radius);
  box-shadow: 0 2px 8px rgba(0, 44, 119, 0.15);
}

.brand span {
  font-size: 14px;
}

.brand strong {
  display: block;
  font-size: 15px;
  font-weight: 700;
  color: var(--color-text);
}

.brand small {
  display: block;
  font-size: 12px;
  color: var(--color-text-light);
  margin-top: 2px;
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 28px;
  font-size: 14px;
  font-weight: 600;
}

.nav-menu a:not(.btn) {
  color: var(--color-text);
  transition: color 0.2s ease;
}

.nav-menu a:not(.btn):hover {
  color: var(--color-accent);
}

.nav-toggle {
  display: none;
  width: 44px;
  height: 44px;
  border: none;
  background: none;
  cursor: pointer;
  padding: 0;
}

.nav-toggle span {
  display: block;
  width: 20px;
  height: 2px;
  margin: 6px auto;
  background: var(--color-text);
  transition: all 0.3s ease;
}

.nav-toggle[aria-expanded="true"] span:nth-child(1) {
  transform: translateY(8px) rotate(45deg);
}

.nav-toggle[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}

.nav-toggle[aria-expanded="true"] span:nth-child(3) {
  transform: translateY(-8px) rotate(-45deg);
}

/* ==================== BUTTONS ==================== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 12px 24px;
  border: none;
  border-radius: var(--radius);
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s ease;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
}

.btn-primary:hover {
  background: var(--color-primary-dark);
  transform: translateY(-2px);
}

.btn-secondary {
  background: #fff;
  color: var(--color-primary);
  border: 2px solid var(--color-primary);
}

.btn-secondary:hover {
  background: #f5f5f5;
}

.btn-secondary-light {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.btn-secondary-light:hover {
  background: rgba(255, 255, 255, 0.2);
}

.btn.full {
  width: 100%;
}

/* ==================== HERO ==================== */
.hero {
  background: #fff;
  padding-top: 40px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 48px;
  align-items: center;
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--color-accent);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.hero-content h1 {
  font-size: clamp(2.2rem, 5vw, 3.5rem);
  margin: 0 0 24px;
  color: var(--color-text);
  line-height: 1.2;
}

.hero-text {
  font-size: 16px;
  color: var(--color-text-light);
  margin: 0 0 32px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  gap: 16px;
  margin: 0 0 40px;
}

.trust-badges {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.badge-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  background: var(--color-gray-light);
  border-radius: var(--radius);
  font-size: 13px;
  font-weight: 600;
}

.badge-icon {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #fff;
  border-radius: 50%;
  font-size: 12px;
}

.hero-image {
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.hero-image img {
  width: 100%;
  display: block;
}

/* ==================== SECTIONS ==================== */
.section-title {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  margin: 0 0 12px;
  color: var(--color-text);
}

.section-subtitle {
  font-size: 16px;
  color: var(--color-text-light);
  margin: 0 0 48px;
  max-width: 600px;
}

/* WHY SECTION */
.why-section {
  background: #fff;
}

.why-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.why-card {
  padding: 32px 24px;
  background: var(--color-gray-light);
  border-radius: var(--radius);
  transition: all 0.3s ease;
}

.why-card:hover {
  background: #fff;
  box-shadow: var(--shadow-md);
}

.why-icon {
  width: 48px;
  height: 48px;
  background: var(--color-primary);
  border-radius: 8px;
  margin-bottom: 20px;
}

.why-card h3 {
  font-size: 18px;
  margin: 0 0 12px;
}

.why-card p {
  font-size: 14px;
  color: var(--color-text-light);
  margin: 0;
  line-height: 1.6;
}

/* PRODUCTS SECTION */
.products-section {
  background: #fff;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-bottom: 48px;
}

.product-card {
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: all 0.3s ease;
}

.product-card:hover {
  box-shadow: var(--shadow-md);
  border-color: var(--color-accent);
}

.product-image {
  width: 100%;
  aspect-ratio: 1.5;
  overflow: hidden;
  background: var(--color-gray-light);
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-info {
  padding: 24px;
}

.product-tag {
  display: inline-block;
  padding: 4px 10px;
  background: var(--color-accent-light);
  color: var(--color-accent);
  border-radius: 4px;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.product-card h3 {
  font-size: 18px;
  margin: 0 0 12px;
}

.product-card p {
  font-size: 14px;
  color: var(--color-text-light);
  margin: 0 0 16px;
  line-height: 1.6;
}

.text-link {
  font-weight: 700;
  color: var(--color-accent);
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: gap 0.2s ease;
}

.text-link:hover {
  gap: 8px;
}

.product-details {
  background: var(--color-gray-light);
  padding: 40px;
  border-radius: var(--radius);
}

.product-details h3 {
  font-size: 22px;
  margin: 0 0 32px;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  margin-bottom: 32px;
}

.detail-block h4 {
  font-size: 16px;
  margin: 0 0 12px;
  color: var(--color-primary);
}

.detail-block p {
  font-size: 14px;
  color: var(--color-text-light);
  margin: 0;
  line-height: 1.6;
}

.medical-disclaimer {
  background: rgba(0, 44, 119, 0.05);
  border-left: 4px solid var(--color-primary);
  padding: 16px 20px;
  border-radius: 4px;
  font-size: 13px;
  color: var(--color-text-light);
}

/* BUSINESS SECTION */
.business-section {
  background: linear-gradient(135deg, #003366 0%, var(--color-primary) 50%, #004f8e 100%);
  color: #fff;
}

.business-wrapper {
  padding: 48px;
  background: rgba(0, 0, 0, 0.1);
  border-radius: var(--radius);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.business-content h2 {
  color: #fff;
  margin-bottom: 16px;
}

.business-content p {
  color: rgba(255, 255, 255, 0.9);
  font-size: 15px;
  line-height: 1.7;
  margin: 0 0 16px;
}

.business-features {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin: 32px 0;
}

.feature {
  padding: 12px 16px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
  font-size: 14px;
  font-weight: 600;
}

.business-actions {
  display: flex;
  gap: 16px;
  margin-top: 32px;
}

/* STORY SECTION */
.story-section {
  background: #fff;
}

.story-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.story-card {
  padding: 32px 24px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  transition: all 0.3s ease;
}

.story-card:hover {
  box-shadow: var(--shadow-md);
}

.story-card h3 {
  font-size: 18px;
  margin: 0 0 16px;
}

.story-card p {
  font-size: 14px;
  color: var(--color-text-light);
  margin: 0;
  line-height: 1.6;
}

/* REGION SECTION */
.region-section {
  background: var(--color-gray-light);
}

.region-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.region-keywords span {
  display: inline-block;
  padding: 8px 14px;
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
}

/* STEPS SECTION */
.steps-section {
  background: #fff;
}

.steps-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20px;
}

.steps-list li {
  text-align: center;
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin: 0 auto 16px;
  background: var(--color-primary);
  color: #fff;
  font-weight: 900;
  border-radius: 50%;
  font-size: 20px;
}

.steps-list h3 {
  font-size: 16px;
  margin: 0 0 8px;
}

.steps-list p {
  font-size: 14px;
  color: var(--color-text-light);
  margin: 0;
}

/* FAQ SECTION */
.faq-section {
  background: #fff;
}

.faq-layout {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 48px;
}

.faq-header h2 {
  margin-bottom: 12px;
}

.faq-accordion {
  display: grid;
  gap: 12px;
}

.faq-item {
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  overflow: hidden;
}

.faq-item button {
  width: 100%;
  padding: 20px;
  border: none;
  background: #fff;
  text-align: left;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background 0.2s ease;
}

.faq-item button:hover {
  background: var(--color-gray-light);
}

.faq-item button::after {
  content: "+";
  font-size: 24px;
  color: var(--color-accent);
  transition: transform 0.3s ease;
}

.faq-item.is-open button::after {
  content: "−";
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.faq-answer p {
  padding: 0 20px 20px;
  margin: 0;
  font-size: 14px;
  color: var(--color-text-light);
  line-height: 1.6;
}

/* CONTACT SECTION */
.contact-section {
  background: #fff;
}

.contact-wrapper {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 48px;
}

.contact-details {
  display: grid;
  gap: 16px;
  margin: 32px 0;
}

.detail-row strong {
  display: block;
  font-size: 12px;
  color: var(--color-accent);
  text-transform: uppercase;
  margin-bottom: 4px;
}

.detail-row p {
  margin: 0;
  font-size: 15px;
}

.detail-row a {
  color: var(--color-accent);
  font-weight: 600;
}

.contact-form {
  display: grid;
  gap: 20px;
  padding: 32px;
  background: var(--color-gray-light);
  border-radius: var(--radius);
}

.form-group {
  display: grid;
  gap: 8px;
}

.form-group.full {
  grid-column: 1 / -1;
}

.form-group label {
  font-weight: 600;
  font-size: 14px;
}

.form-group input,
.form-group select,
.form-group textarea {
  padding: 12px 14px;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  font-family: inherit;
  font-size: 14px;
  transition: border-color 0.2s ease;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(0, 44, 119, 0.1);
}

.privacy-label {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 10px;
  align-items: start;
  font-size: 13px;
  color: var(--color-text-light);
}

.privacy-label input {
  width: 18px;
  height: 18px;
  margin-top: 3px;
}

.error-message {
  display: none;
  font-size: 12px;
  color: #d92020;
}

.form-group.is-invalid input,
.form-group.is-invalid select,
.form-group.is-invalid textarea {
  border-color: #d92020;
}

.form-group.is-invalid .error-message,
.privacy-error.is-visible {
  display: block;
}

.success-message {
  display: none;
  padding: 14px 16px;
  background: #ecfdf3;
  color: #05603a;
  border-radius: 4px;
  font-weight: 600;
  font-size: 14px;
}

.success-message.is-visible {
  display: block;
  grid-column: 1 / -1;
}

/* FOOTER */
.site-footer {
  background: #1c2938;
  color: #dce7f0;
  padding: 48px 0 32px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1fr 0.6fr 1.4fr;
  gap: 48px;
  align-items: start;
}

.footer-brand strong {
  display: block;
  color: #fff;
  font-size: 16px;
  margin-bottom: 8px;
}

.footer-brand p {
  margin: 6px 0 0;
  font-size: 13px;
  color: #bdc9d5;
}

.footer-links {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-links a {
  font-weight: 600;
  font-size: 14px;
  transition: color 0.2s ease;
}

.footer-links a:hover {
  color: #fff;
}

.footer-disclaimer p {
  margin: 0 0 12px;
  font-size: 12px;
  line-height: 1.6;
}

.footer-disclaimer p:last-child {
  margin-bottom: 0;
}

/* REVEAL ANIMATION */
.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* FLOATING CTA */
.floating-cta {
  display: none;
  position: fixed;
  bottom: 20px;
  right: 20px;
  left: 20px;
  z-index: 35;
  min-height: 48px;
  background: var(--color-accent);
  color: #fff;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  box-shadow: 0 4px 12px rgba(230, 26, 41, 0.3);
}

/* RESPONSIVE */
@media (max-width: 1080px) {
  .why-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .products-grid {
    grid-template-columns: 1fr;
  }

  .story-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .details-grid {
    grid-template-columns: 1fr;
  }

  .steps-list {
    grid-template-columns: repeat(3, 1fr);
  }

  .faq-layout {
    grid-template-columns: 1fr;
  }

  .contact-wrapper {
    grid-template-columns: 1fr;
  }

  .business-features {
    grid-template-columns: 1fr;
  }

  .hero-actions {
    flex-direction: column;
  }

  .business-actions {
    flex-direction: column;
  }
}

@media (max-width: 900px) {
  :root {
    --header-height: 70px;
  }

  .section {
    padding: 60px 0;
  }

  .nav-toggle {
    display: block;
  }

  .nav-menu {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    flex-direction: column;
    gap: 0;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    padding: 16px;
    transform: translateY(-110%);
    visibility: hidden;
    transition: transform 0.3s ease, visibility 0.3s ease;
    z-index: 39;
  }

  .nav-menu.is-open {
    transform: translateY(0);
    visibility: visible;
  }

  .nav-menu a {
    padding: 12px 0;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .floating-cta {
    display: flex;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }
}

@media (max-width: 680px) {
  .hero-content h1 {
    font-size: 28px;
  }

  .section-title {
    font-size: 24px;
  }

  .why-grid,
  .story-grid,
  .region-keywords {
    grid-template-columns: 1fr;
  }

  .trust-badges {
    grid-template-columns: 1fr;
  }

  .steps-list {
    grid-template-columns: 1fr;
  }

  .product-details,
  .business-wrapper,
  .contact-form {
    padding: 24px;
  }

  .contact-actions,
  .hero-actions {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }

  html {
    scroll-behavior: auto;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}
